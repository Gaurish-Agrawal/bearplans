{
  "manifest_version": 3,
  "name": "BearPlans Workday Importer",
  "description": "Build BearPlans schedules from WashU Workday courses and save a chosen schedule back to Workday.",
  "version": "1.3.1",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://myworkday.com/*",
    "https://www.myworkday.com/*",
    "https://*.myworkday.com/*",
    "https://bearplans.pythonanywhere.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://myworkday.com/*",
        "https://www.myworkday.com/*",
        "https://*.myworkday.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.myworkday.com/wustl/*", "https://myworkday.com/wustl/*"],
      "js": ["export-common.js", "workday-saver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bearplans.pythonanywhere.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "BearPlans",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
